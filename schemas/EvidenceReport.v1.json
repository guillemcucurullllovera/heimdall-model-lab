{
  "$defs": {
    "Causality": {
      "enum": [
        "FILTERED",
        "SMOOTHED",
        "NOT_APPLICABLE"
      ],
      "title": "Causality",
      "type": "string"
    },
    "GuardResult": {
      "additionalProperties": false,
      "properties": {
        "margin_observed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Margin Observed"
        },
        "margin_required": {
          "title": "Margin Required",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "passed",
        "margin_required"
      ],
      "title": "GuardResult",
      "type": "object"
    },
    "ScoreResult": {
      "additionalProperties": false,
      "properties": {
        "causality": {
          "$ref": "#/$defs/Causality",
          "default": "NOT_APPLICABLE"
        },
        "data_cutoff": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Cutoff"
        },
        "mde": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mde"
        },
        "n": {
          "title": "N",
          "type": "integer"
        },
        "n_independent": {
          "title": "N Independent",
          "type": "number"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "value": {
          "description": "stringified; see canon/jcs.py's float policy",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value",
        "n",
        "n_independent"
      ],
      "title": "ScoreResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "as_of_utc": {
      "format": "date-time",
      "title": "As Of Utc",
      "type": "string"
    },
    "gate_result_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "hash of the GateResult record this report was judged against, if any",
      "title": "Gate Result Hash"
    },
    "gate_verdict": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "'SUFFICIENT' | 'INSUFFICIENT' | 'FAIL' | None",
      "title": "Gate Verdict"
    },
    "guard_results": {
      "items": {
        "$ref": "#/$defs/GuardResult"
      },
      "title": "Guard Results",
      "type": "array"
    },
    "model_version_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Model Version Hash",
      "type": "string"
    },
    "prereg_id": {
      "title": "Prereg Id",
      "type": "string"
    },
    "primary_score_result": {
      "$ref": "#/$defs/ScoreResult"
    },
    "report_id": {
      "title": "Report Id",
      "type": "string"
    },
    "report_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Sha256",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_name": {
      "default": "EvidenceReport",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "secondary_score_results": {
      "items": {
        "$ref": "#/$defs/ScoreResult"
      },
      "title": "Secondary Score Results",
      "type": "array"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "report_id",
    "model_version_hash",
    "task_id",
    "prereg_id",
    "run_id",
    "as_of_utc",
    "primary_score_result",
    "report_sha256"
  ],
  "title": "EvidenceReport",
  "type": "object"
}
