{
  "$defs": {
    "AdjustmentInfo": {
      "additionalProperties": false,
      "properties": {
        "corporate_actions_snapshot_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Corporate Actions Snapshot Id"
        },
        "kind": {
          "description": "e.g. 'none', 'split_dividend_adjusted', 'total_return'",
          "title": "Kind",
          "type": "string"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        }
      },
      "required": [
        "kind"
      ],
      "title": "AdjustmentInfo",
      "type": "object"
    },
    "CalendarInfo": {
      "additionalProperties": false,
      "properties": {
        "exchange": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exchange"
        },
        "holidays_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Holidays Version"
        },
        "timezone": {
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "timezone"
      ],
      "title": "CalendarInfo",
      "type": "object"
    },
    "KnownGap": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "reason"
      ],
      "title": "KnownGap",
      "type": "object"
    },
    "LicenceStatus": {
      "description": "Assigned to a *source* (a provider/series), per the R1b terms audit.",
      "enum": [
        "CLEAR",
        "UNRESOLVED",
        "RESTRICTED"
      ],
      "title": "LicenceStatus",
      "type": "string"
    },
    "PitClass": {
      "enum": [
        "AS_RELEASED",
        "AS_REVISED",
        "SNAPSHOT_ONLY"
      ],
      "title": "PitClass",
      "type": "string"
    },
    "PitRow": {
      "additionalProperties": false,
      "description": "One row of the PIT long table.\n\n**P1-4 remediation** (adversarial review finding D.4): \"no\n`model_validator` anywhere enforces `knowledge_time_utc >=\nrealtime_start` on `PitRow` -- a deliberately-backdated `PitRow`\n(knowledge_time_utc six years before realtime_start) is accepted\nsilently by pydantic.\" Fixed below: a row cannot claim to have been\nknowable before its own vintage began, and `realtime_end` (when set)\ncannot precede `realtime_start`.",
      "properties": {
        "knowledge_time_utc": {
          "description": "our conservative available_at; when this observation was actually knowable",
          "format": "date-time",
          "title": "Knowledge Time Utc",
          "type": "string"
        },
        "observation_period": {
          "format": "date",
          "title": "Observation Period",
          "type": "string"
        },
        "realtime_end": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "vintage window end; None if still current",
          "title": "Realtime End"
        },
        "realtime_start": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "vintage window start; None if unrevised/unknown",
          "title": "Realtime Start"
        },
        "series_id": {
          "title": "Series Id",
          "type": "string"
        },
        "source_snapshot_sha": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Snapshot Sha",
          "type": "string"
        },
        "value": {
          "description": "stored as a string to avoid float-canonicalization ambiguity",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "series_id",
        "observation_period",
        "value",
        "knowledge_time_utc",
        "source_snapshot_sha"
      ],
      "title": "PitRow",
      "type": "object"
    },
    "ResearchState": {
      "description": "Derived, mechanically, from a source's LicenceStatus. Never\nhand-assigned.",
      "enum": [
        "promotion_eligible",
        "research_only_unlicensed",
        "quarantined"
      ],
      "title": "ResearchState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "adjustments": {
      "$ref": "#/$defs/AdjustmentInfo"
    },
    "calendar": {
      "$ref": "#/$defs/CalendarInfo"
    },
    "datasheet_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Datasheet Hash"
    },
    "dq_report_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dq Report Hash"
    },
    "endpoint_or_path": {
      "title": "Endpoint Or Path",
      "type": "string"
    },
    "first_bar_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "First Bar Date"
    },
    "first_bar_lag_days": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "declared lag if first_bar_date != requested_start (rule 6)",
      "title": "First Bar Lag Days"
    },
    "known_gaps": {
      "items": {
        "$ref": "#/$defs/KnownGap"
      },
      "title": "Known Gaps",
      "type": "array"
    },
    "last_bar_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Bar Date"
    },
    "licence_status": {
      "$ref": "#/$defs/LicenceStatus"
    },
    "logical_content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Logical Content Hash",
      "type": "string"
    },
    "params": {
      "additionalProperties": true,
      "title": "Params",
      "type": "object"
    },
    "pit_class": {
      "$ref": "#/$defs/PitClass"
    },
    "raw_payload_hashes": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Raw Payload Hashes",
      "type": "array"
    },
    "requested_start": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requested Start"
    },
    "research_state": {
      "$ref": "#/$defs/ResearchState",
      "description": "must equal derive_research_state(licence_status); validated below"
    },
    "retrieved_at_utc": {
      "format": "date-time",
      "title": "Retrieved At Utc",
      "type": "string"
    },
    "rows": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/PitRow"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rows"
    },
    "rows_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rows Path"
    },
    "schema_id": {
      "title": "Schema Id",
      "type": "string"
    },
    "schema_name": {
      "default": "DatasetSnapshot",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "snapshot_id": {
      "title": "Snapshot Id",
      "type": "string"
    },
    "source_id": {
      "title": "Source Id",
      "type": "string"
    }
  },
  "required": [
    "snapshot_id",
    "source_id",
    "endpoint_or_path",
    "retrieved_at_utc",
    "licence_status",
    "research_state",
    "logical_content_hash",
    "schema_id",
    "calendar",
    "adjustments",
    "pit_class"
  ],
  "title": "DatasetSnapshot",
  "type": "object"
}
