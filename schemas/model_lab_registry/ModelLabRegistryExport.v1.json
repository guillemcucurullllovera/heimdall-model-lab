    "OOSProvenance": {
      "additionalProperties": false,
      "description": "Statistical (Model-Lab-internal) out-of-sample provenance --\nDISTINCT from economic OOS (which would require a real decision\nmapping and therefore does not exist for anything this pass).",
      "properties": {
        "has_statistical_oos_evidence": {
