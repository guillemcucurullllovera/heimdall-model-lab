{
  "$defs": {
    "BaselineComparisonResult": {
      "additionalProperties": false,
      "description": "BASELINE AMC DECISION vs MODEL-ASSISTED AMC DECISION. For every\nimplemented model this pass, this is populated with explicit \"no\nmapping exists\" descriptions and `positive_incremental_value_\ndemonstrated=False` -- never a real number, since there is no\nbaseline AMC decision to compare against without a decision mapping\n(`DecisionMappingResult.has_mapping=False`). `None` only for\nunimplemented (literature-candidate) entries, where there is nothing\nto even describe.",
      "properties": {
        "baseline_description": {
          "title": "Baseline Description",
          "type": "string"
        },
        "incremental_capital_usage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Incremental Capital Usage"
        },
        "incremental_costs": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Incremental Costs"
        },
        "incremental_drawdown": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Incremental Drawdown"
        },
        "incremental_pnl_payoff": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Incremental Pnl Payoff"
        },
        "incremental_risk": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Incremental Risk"
        },
        "incremental_stability": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Incremental Stability"
        },
        "incremental_tail_behaviour": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Incremental Tail Behaviour"
        },
        "model_assisted_description": {
          "title": "Model Assisted Description",
          "type": "string"
        },
        "positive_incremental_value_demonstrated": {
          "description": "MUST be False unless the comparison above actually demonstrates it -- never True by default",
          "title": "Positive Incremental Value Demonstrated",
          "type": "boolean"
        }
      },
      "required": [
        "baseline_description",
        "model_assisted_description",
        "positive_incremental_value_demonstrated"
      ],
      "title": "BaselineComparisonResult",
      "type": "object"
    },
    "Causality": {
      "enum": [
        "FILTERED",
        "SMOOTHED",
        "NOT_APPLICABLE"
      ],
      "title": "Causality",
      "type": "string"
    },
    "ChartSeries": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/ChartSeriesPoint"
          },
          "title": "Points",
          "type": "array"
        },
        "role": {
          "description": "'challenger' | 'incumbent' | 'naive' | 'comparator'",
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "label",
        "role",
        "points"
      ],
      "title": "ChartSeries",
      "type": "object"
    },
    "ChartSeriesPoint": {
      "additionalProperties": false,
      "description": "A single plotted value. `unavailable=True` renders as UNAVAILABLE in\nthe Command Center rather than as a zero \u2014 `value` must be None\nwhenever `unavailable` is True, and non-None otherwise.",
      "properties": {
        "band_lower": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Band Lower"
        },
        "band_upper": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Band Upper"
        },
        "unavailable": {
          "default": false,
          "title": "Unavailable",
          "type": "boolean"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "stringified to avoid float-canonicalization issues",
          "title": "Value"
        },
        "x_label": {
          "title": "X Label",
          "type": "string"
        }
      },
      "required": [
        "x_label"
      ],
      "title": "ChartSeriesPoint",
      "type": "object"
    },
    "ChartSpec": {
      "additionalProperties": false,
      "properties": {
        "causality": {
          "$ref": "#/$defs/Causality"
        },
        "chart_id": {
          "title": "Chart Id",
          "type": "string"
        },
        "chart_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Chart Sha256",
          "type": "string"
        },
        "data_authority": {
          "$ref": "#/$defs/DataAuthority"
        },
        "data_cutoff": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Cutoff"
        },
        "decision_question": {
          "title": "Decision Question",
          "type": "string"
        },
        "incumbent_id": {
          "title": "Incumbent Id",
          "type": "string"
        },
        "mde": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mde"
        },
        "n": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N"
        },
        "n_independent": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N Independent"
        },
        "schema_name": {
          "default": "ChartSpec",
          "title": "Schema Name",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "series": {
          "items": {
            "$ref": "#/$defs/ChartSeries"
          },
          "title": "Series",
          "type": "array"
        }
      },
      "required": [
        "chart_id",
        "decision_question",
        "incumbent_id",
        "series",
        "causality",
        "data_authority",
        "chart_sha256"
      ],
      "title": "ChartSpec",
      "type": "object"
    },
    "DataAuthority": {
      "enum": [
        "PROVISIONAL",
        "UNAVAILABLE"
      ],
      "title": "DataAuthority",
      "type": "string"
    },
    "DecisionMappingResult": {
      "additionalProperties": false,
      "description": "Whether, and how, this model's output could enter a real AMC\ndecision. `has_mapping=False` for all 26 registry entries this pass\n-- see `MODEL_LAB_AMC_DECISION_MAPPING_INVESTIGATION.md` for why.",
      "properties": {
        "amc_entry_point_citation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "real AMC file:field this output would enter through, or None",
          "title": "Amc Entry Point Citation"
        },
        "applicable_portfolio_risk_constraints": {
          "items": {
            "type": "string"
          },
          "title": "Applicable Portfolio Risk Constraints",
          "type": "array"
        },
        "baseline_decision_description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Decision Description"
        },
        "decision_it_would_change": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision It Would Change"
        },
        "execution_assumptions": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Assumptions"
        },
        "has_mapping": {
          "title": "Has Mapping",
          "type": "boolean"
        },
        "missing_data": {
          "items": {
            "type": "string"
          },
          "title": "Missing Data",
          "type": "array"
        },
        "model_assisted_decision_description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Assisted Decision Description"
        },
        "model_output_description": {
          "title": "Model Output Description",
          "type": "string"
        },
        "reason_not_evaluable": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Not Evaluable"
        },
        "required_data": {
          "items": {
            "type": "string"
          },
          "title": "Required Data",
          "type": "array"
        },
        "required_market_option_data": {
          "items": {
            "type": "string"
          },
          "title": "Required Market Option Data",
          "type": "array"
        }
      },
      "required": [
        "has_mapping",
        "model_output_description"
      ],
      "title": "DecisionMappingResult",
      "type": "object"
    },
    "EconomicEvaluationResult": {
      "additionalProperties": false,
      "description": "Populated ONLY when a genuine economic evaluation was actually run\n-- every field is `None`/empty for every model this pass, since\n`DecisionMappingResult.has_mapping` is False everywhere. A future\nmodel with a real decision mapping would have this filled from real\ncomputation, never from an assumption.",
      "properties": {
        "annualized_return": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Annualized Return"
        },
        "capital_usage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capital Usage"
        },
        "cumulative_pnl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cumulative Pnl"
        },
        "exposure_concentration": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exposure Concentration"
        },
        "hit_rate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hit Rate"
        },
        "max_drawdown": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Drawdown"
        },
        "n_independent_events": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N Independent Events"
        },
        "n_observations": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N Observations"
        },
        "options_payoff_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "for options/structured trades: payoff/risk characteristics, never a forced equity-style metric",
          "title": "Options Payoff Note"
        },
        "regime_breakdown": {
          "additionalProperties": true,
          "title": "Regime Breakdown",
          "type": "object"
        },
        "sharpe_ratio": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sharpe Ratio"
        },
        "tail_loss_es": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tail Loss Es"
        },
        "transaction_costs": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transaction Costs"
        },
        "turnover": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Turnover"
        },
        "volatility": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Volatility"
        }
      },
      "title": "EconomicEvaluationResult",
      "type": "object"
    },
    "EstablishmentState": {
      "description": "Used wherever a value may genuinely not exist yet. Never silently\nomitted -- a field using this enum is always PRESENT in the export,\njust carrying this instead of a fabricated real value.",
      "enum": [
        "ESTABLISHED",
        "PENDING",
        "NOT_ESTABLISHED"
      ],
      "title": "EstablishmentState",
      "type": "string"
    },
    "EvaluationStatus": {
      "enum": [
        "NOT_EVALUATED",
        "EVALUATION_PENDING",
        "NOT_EVALUABLE",
        "EVALUATED_FAILED",
        "EVALUATED_INCONCLUSIVE",
        "ELIGIBLE_PENDING_HUMAN_AUTHORIZATION",
        "AUTHORIZED"
      ],
      "title": "EvaluationStatus",
      "type": "string"
    },
    "GateEvidenceState": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_ESTABLISHED",
        "NOT_APPLICABLE"
      ],
      "title": "GateEvidenceState",
      "type": "string"
    },
    "ModelAMCPromotionEvaluation": {
      "additionalProperties": false,
      "properties": {
        "baseline_comparison": {
          "anyOf": [
            {
              "$ref": "#/$defs/BaselineComparisonResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "decision_mapping": {
          "$ref": "#/$defs/DecisionMappingResult"
        },
        "economic_evaluation": {
          "anyOf": [
            {
              "$ref": "#/$defs/EconomicEvaluationResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "gates": {
          "items": {
            "$ref": "#/$defs/PromotionGateResult"
          },
          "title": "Gates",
          "type": "array"
        },
        "human_authorization_state": {
          "default": "NOT_SOUGHT",
          "description": "'NOT_SOUGHT' for every model this pass -- never anything implying a human was asked",
          "title": "Human Authorization State",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "oos_provenance": {
          "$ref": "#/$defs/OOSProvenance"
        },
        "overall_status": {
          "$ref": "#/$defs/EvaluationStatus"
        },
        "prospective_sufficiency": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProspectiveSufficiency"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_name": {
          "default": "ModelAMCPromotionEvaluation",
          "title": "Schema Name",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "status_reasoning": {
          "title": "Status Reasoning",
          "type": "string"
        }
      },
      "required": [
        "model_id",
        "overall_status",
        "status_reasoning",
        "decision_mapping",
        "oos_provenance",
        "gates"
      ],
      "title": "ModelAMCPromotionEvaluation",
      "type": "object"
    },
