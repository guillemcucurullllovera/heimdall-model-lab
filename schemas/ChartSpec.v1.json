{
  "$defs": {
    "Causality": {
      "enum": [
        "FILTERED",
        "SMOOTHED",
        "NOT_APPLICABLE"
      ],
      "title": "Causality",
      "type": "string"
    },
    "ChartSeries": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/ChartSeriesPoint"
          },
          "title": "Points",
          "type": "array"
        },
        "role": {
          "description": "'challenger' | 'incumbent' | 'naive' | 'comparator'",
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "label",
        "role",
        "points"
      ],
      "title": "ChartSeries",
      "type": "object"
    },
    "ChartSeriesPoint": {
      "additionalProperties": false,
      "description": "A single plotted value. `unavailable=True` renders as UNAVAILABLE in\nthe Command Center rather than as a zero \u2014 `value` must be None\nwhenever `unavailable` is True, and non-None otherwise.",
      "properties": {
        "band_lower": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Band Lower"
        },
        "band_upper": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Band Upper"
        },
        "unavailable": {
          "default": false,
          "title": "Unavailable",
          "type": "boolean"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "stringified to avoid float-canonicalization issues",
          "title": "Value"
        },
        "x_label": {
          "title": "X Label",
          "type": "string"
        }
      },
      "required": [
        "x_label"
      ],
      "title": "ChartSeriesPoint",
      "type": "object"
    },
    "DataAuthority": {
      "enum": [
        "PROVISIONAL",
        "UNAVAILABLE"
      ],
      "title": "DataAuthority",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "causality": {
      "$ref": "#/$defs/Causality"
    },
    "chart_id": {
      "title": "Chart Id",
      "type": "string"
    },
    "chart_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Chart Sha256",
      "type": "string"
    },
    "data_authority": {
      "$ref": "#/$defs/DataAuthority"
    },
    "data_cutoff": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Data Cutoff"
    },
    "decision_question": {
      "title": "Decision Question",
      "type": "string"
    },
    "incumbent_id": {
      "title": "Incumbent Id",
      "type": "string"
    },
    "mde": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mde"
    },
    "n": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "N"
    },
    "n_independent": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "N Independent"
    },
    "schema_name": {
      "default": "ChartSpec",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "series": {
      "items": {
        "$ref": "#/$defs/ChartSeries"
      },
      "title": "Series",
      "type": "array"
    }
  },
  "required": [
    "chart_id",
    "decision_question",
    "incumbent_id",
    "series",
    "causality",
    "data_authority",
    "chart_sha256"
  ],
  "title": "ChartSpec",
  "type": "object"
}
