{
  "$defs": {
    "DeterminismTier": {
      "enum": [
        "BITWISE",
        "NUMERIC",
        "STATISTICAL"
      ],
      "title": "DeterminismTier",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "blas_threads": {
      "minimum": 1,
      "title": "Blas Threads",
      "type": "integer"
    },
    "code_tree_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Code Tree Hash",
      "type": "string"
    },
    "cores": {
      "minimum": 1,
      "title": "Cores",
      "type": "integer"
    },
    "cpu_flags": {
      "items": {
        "type": "string"
      },
      "title": "Cpu Flags",
      "type": "array"
    },
    "dataset_hashes": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Dataset Hashes",
      "type": "array"
    },
    "determinism_tier": {
      "$ref": "#/$defs/DeterminismTier"
    },
    "dirty": {
      "description": "must be False for evidence-grade runs",
      "title": "Dirty",
      "type": "boolean"
    },
    "env_lock_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Env Lock Hash",
      "type": "string"
    },
    "experiment_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Experiment Fingerprint",
      "type": "string"
    },
    "output_hashes": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Output Hashes",
      "type": "array"
    },
    "peak_mem_bytes": {
      "minimum": 0,
      "title": "Peak Mem Bytes",
      "type": "integer"
    },
    "prereg_id": {
      "title": "Prereg Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_name": {
      "default": "RunManifest",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "seed_tree": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Seed Tree",
      "type": "object"
    },
    "wall_seconds": {
      "minimum": 0,
      "title": "Wall Seconds",
      "type": "number"
    }
  },
  "required": [
    "run_id",
    "prereg_id",
    "experiment_fingerprint",
    "code_tree_hash",
    "dirty",
    "env_lock_hash",
    "blas_threads",
    "dataset_hashes",
    "output_hashes",
    "determinism_tier",
    "wall_seconds",
    "cores",
    "peak_mem_bytes"
  ],
  "title": "RunManifest",
  "type": "object"
}
